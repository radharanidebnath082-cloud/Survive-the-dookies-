<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Survive the Dookies</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body { background: #1a0f00; color: #fff; font-family: 'Courier New', monospace; text-align: center; overflow: hidden; }
        #game-container { position: relative; width: 800px; height: 450px; margin: 20px auto; border: 4px solid #8b5a2b; background: #2a1a08; box-shadow: 0 0 20px #000; }
        canvas { width: 100%; height: 100%; image-rendering: pixelated; display: block; }
        .ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: 10px; }
        .hud { display: flex; justify-content: space-between; font-size: 16px; text-shadow: 2px 2px #000; font-weight: bold; }
        .dialogue-box { background: rgba(0,0,0,0.85); border: 2px solid #e6b800; padding: 12px; margin: 10px; border-radius: 8px; text-align: left; display: none; pointer-events: auto; }
        .dialogue-title { color: #e6b800; font-weight: bold; margin-bottom: 4px; }
        .dialogue-text { color: #fff; font-size: 14px; }
        #controls { display: flex; justify-content: center; gap: 15px; margin-top: 10px; }
        .btn { background: #8b5a2b; border: 2px solid #d2b48c; color: white; padding: 12px 20px; font-weight: bold; cursor: pointer; border-radius: 6px; touch-action: manipulation; }
        .btn:active { background: #5c3a1a; }
    </style>
</head>
<body>

<h1>SURVIVE THE DOOKIES</h1>
<div id="game-container">
    <canvas id="canvas" width="800" height="450"></canvas>
    <div class="ui-layer">
        <div class="hud">
            <div>Wipes: <span id="hp">5</span>/5</div>
            <div>Level: <span id="lvl">1</span></div>
            <div>Score: <span id="score">0</span></div>
        </div>
        <div id="dialogue" class="dialogue-box">
            <div id="diag-title" class="dialogue-title">Baby Stinky</div>
            <div id="diag-text" class="dialogue-text">Uh-oh... dis not the potty room...</div>
        </div>
    </div>
</div>

<div id="controls">
    <button class="btn" id="btn-left">◀ Left</button>
    <button class="btn" id="btn-jump">▲ Jump</button>
    <button class="btn" id="btn-right">Right ▶</button>
    <button class="btn" id="btn-attack">⚔ Attack</button>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

let gameState = 'PLAY';
let level = 1;
let score = 0;

const player = {
    x: 50, y: 300, w: 24, h: 32, vx: 0, vy: 0,
    speed: 4, jumpPower: -11, hp: 5, maxHp: 5,
    grounded: false, facing: 1, attacking: false, attackTimer: 0
};

const keys = {};
window.addEventListener('keydown', e => keys[e.code] = true);
window.addEventListener('keyup', e => keys[e.code] = false);

// Touch Controls
const bindBtn = (id, k) => {
    const el = document.getElementById(id);
    el.addEventListener('touchstart', (e) => { e.preventDefault(); keys[k] = true; });
    el.addEventListener('touchend', (e) => { e.preventDefault(); keys[k] = false; });
    el.addEventListener('mousedown', () => keys[k] = true);
    el.addEventListener('mouseup', () => keys[k] = false);
};
bindBtn('btn-left', 'ArrowLeft');
bindBtn('btn-right', 'ArrowRight');
bindBtn('btn-jump', 'KeyW');
bindBtn('btn-attack', 'Space');

const platforms = [
    {x: 0, y: 400, w: 800, h: 50},
    {x: 150, y: 300, w: 100, h: 20},
    {x: 320, y: 220, w: 120, h: 20},
    {x: 550, y: 150, w: 150, h: 20}
];

function update() {
    if (keys['ArrowLeft'] || keys['KeyA']) { player.vx = -player.speed; player.facing = -1; }
    else if (keys['ArrowRight'] || keys['KeyD']) { player.vx = player.speed; player.facing = 1; }
    else { player.vx = 0; }

    if ((keys['ArrowUp'] || keys['KeyW'] || keys['Space']) && player.grounded) {
        player.vy = player.jumpPower;
        player.grounded = false;
    }

    player.vy += 0.5; // Gravity
    player.x += player.vx;
    player.y += player.vy;

    // Platform Collisions
    player.grounded = false;
    for (let p of platforms) {
        if (player.x < p.x + p.w && player.x + player.w > p.x &&
            player.y + player.h > p.y && player.y + player.h < p.y + p.h + player.vy) {
            player.y = p.y - player.h;
            player.vy = 0;
            player.grounded = true;
        }
    }

    // World Bounds
    if (player.x < 0) player.x = 0;
    if (player.x + player.w > canvas.width) player.x = canvas.width - player.w;
    if (player.y > canvas.height) { player.x = 50; player.y = 300; player.hp--; }

    document.getElementById('hp').innerText = Math.max(0, player.hp);
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw Platforms
    ctx.fillStyle = '#5c3a1a';
    for (let p of platforms) {
        ctx.fillRect(p.x, p.y, p.w, p.h);
    }

    // Draw Baby Stinky
    ctx.fillStyle = '#ffdbac'; // Skin
    ctx.fillRect(player.x, player.y, player.w, player.h);
    ctx.fillStyle = '#ffffff'; // Diaper
    ctx.fillRect(player.x, player.y + 20, player.w, 12);
    
    // Eyes
    ctx.fillStyle = '#000';
    let eyeOffset = player.facing === 1 ? 16 : 4;
    ctx.fillRect(player.x + eyeOffset, player.y + 6, 4, 4);
}

function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
}

loop();
</script>

</body>
</html>